# Test-only values for the Playwright e2e server (scripts/e2e-db-server.mjs), which runs `next start` on a
# throwaway PGlite database in the OS temp directory (DATABASE_URL and BETTER_AUTH_URL are set by the script).
# Loaded with `node --env-file=.env.test.example`, and read by tests/e2e/test-env.ts for the seeded users.
# Obviously fake: committed on purpose, never use any of these values anywhere real.
BETTER_AUTH_SECRET=e2e-only-not-a-real-secret-0123456789abcdef
SEED_ADMIN_EMAIL=e2e-admin@example.test
SEED_ADMIN_PASSWORD=e2e-admin-password-not-real
SEED_CLIENT_EMAIL=e2e-client@example.test
SEED_CLIENT_PASSWORD=e2e-client-password-not-real
