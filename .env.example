# Copy to .env.local. Never commit real values.
# Validated by src/server/env.ts — keep this file in sync (enforced by tests/unit/env.test.ts).

# development | preview | production
APP_ENV=development
# on | off — anything but "on" keeps the site noindex
INDEXING=off
# Public base URL of this deployment (optional)
SITE_URL=
# node | cloudflare — selects src/server/platform adapter
PLATFORM=node

# Database (optional; without it the site serves the static catalog and sign-in is unavailable).
# postgres://… (or a Neon URL) for a real database, pglite://.data/pglite for a local
# zero-install database on disk, pglite://memory for a throwaway one.
DATABASE_URL=
# Required (at least 32 random characters) when DATABASE_URL is set.
BETTER_AUTH_SECRET=
# Public base URL used by Better Auth (optional; derived from the request when unset)
BETTER_AUTH_URL=
# Test users created by `pnpm db:seed` (all four required by the seed; password at least 8 characters)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_CLIENT_EMAIL=
SEED_CLIENT_PASSWORD=
