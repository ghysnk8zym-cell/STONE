# Copy to .env.local. Never commit real values.
# Validated by src/server/env.ts — keep this file in sync (enforced by tests/unit/env.test.ts).
# Owner steps for Neon + Cloudflare: docs/DEPLOYMENT.md, section 3. Local database: docs/DEVELOPMENT.md.

# development | preview | production
# Set production on any real production deploy (the styleguide 404s, cookies are Secure on Node hosts).
APP_ENV=development
# on | off — anything but "on" keeps the site noindex (inlined at build time)
INDEXING=off
# Public base URL of this deployment (optional; also a trusted origin for sign-in)
SITE_URL=
# node | cloudflare — selects src/server/platform adapter (and where the client IP for rate limiting comes from)
PLATFORM=node

# Database (optional; without it the site serves the static catalog and sign-in is unavailable).
# postgres://… (a *.neon.tech host uses the Neon HTTP driver) for a real database, pglite://.data/pglite for a
# local zero-install database on disk, pglite://memory for a throwaway one. SECRET: it contains the password.
DATABASE_URL=
# SECRET. Required (at least 32 random characters) when DATABASE_URL is set. Generate locally:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# Public base URL used by Better Auth (optional; derived from the request when unset — leave it unset on Cloudflare
# previews, each has its own host). It and SITE_URL are the trusted origins. Cookies are Secure unless this is
# http://localhost (or, when unset, APP_ENV=development).
BETTER_AUTH_URL=
# Test users created by `pnpm db:seed` (all four required by the seed; passwords at least 8 characters, strong and
# unique on any shared environment). Only the seed reads them; the running site never does.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_CLIENT_EMAIL=
SEED_CLIENT_PASSWORD=
# Not read from this file on purpose: to seed a REMOTE database set SEED_ALLOW_REMOTE=1 in the terminal for that one
# command (docs/DEPLOYMENT.md, section 3.4). The seed refuses a remote database otherwise.
