# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/
/blob-report/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# cloudflare / opennext
/.open-next/
/.wrangler/
.dev.vars*

# typescript
*.tsbuildinfo
next-env.d.ts

# agent workspaces
/.superpowers/
/.claude/worktrees/

# local tool caches
/.impeccable/

# Figma source rasters (re-download via assets/figma-manifest.json node ids)
/assets/source/

