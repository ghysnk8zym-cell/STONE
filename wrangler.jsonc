// Cloudflare Workers config for the OpenNext build (ADR-001). Not used on other hosts.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker name in the Cloudflare dashboard (Workers Builds).
  "name": "stone",
  "main": ".open-next/worker.js",
  // Builds the OpenNext worker only if it is missing (Workers Builds preview branches).
  "build": {
    "command": "node scripts/ensure-opennext-build.mjs",
  },
  "compatibility_date": "2026-09-29",
  // stone.<subdomain>.workers.dev for main; <preview-name>-stone.<subdomain>.workers.dev for PRs.
  "workers_dev": true,
  "preview_urls": true,
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "stone",
    },
  ],
  // Non-secret runtime defaults; secrets are set in the dashboard, never here.
  "vars": {
    "PLATFORM": "cloudflare",
    "APP_ENV": "preview",
  },
  // Worker Previews (`wrangler preview`, used by Workers Builds for non-production branches)
  // do not inherit top-level vars. The self-reference service binding is omitted on purpose:
  // it is only needed for ISR revalidation, which this app does not use.
  "previews": {
    "vars": {
      "PLATFORM": "cloudflare",
      "APP_ENV": "preview",
    },
  },
  // Customer-review TEST shop: a separate Worker (`stone-test`), deployed by hand from the CI-built
  // OpenNext artifact with `wrangler deploy --env test` (docs/DEPLOYMENT.md, "Test shop"). It never
  // touches the Git-connected `stone` Worker. Secrets (DATABASE_URL, BETTER_AUTH_SECRET) are set with
  // `wrangler secret put --env test`, never here. Environments do not inherit vars or bindings.
  "env": {
    "test": {
      "name": "stone-test",
      "workers_dev": true,
      "preview_urls": false,
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "stone-test",
        },
      ],
      "vars": {
        "PLATFORM": "cloudflare",
        "APP_ENV": "preview",
        "INDEXING": "off",
        "BETTER_AUTH_URL": "https://stone-test.gb8cj746n2.workers.dev",
        "SITE_URL": "https://stone-test.gb8cj746n2.workers.dev",
      },
    },
  },
}
